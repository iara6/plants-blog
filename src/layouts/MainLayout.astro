---
// component imports
import MainHead from "./MainHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import SlideInHeader from "../components/SlideInHeader.astro";

const {
  title = "My Astro Plants Blog",
  description = "Невероятный сайт о прекрасных растениях и не только.",
  robots = false,
  frontmatter,
} = Astro.props;

// style import
/* import "../styles/styles.css"; */
---

<!doctype html>
<html lang="ru">
  <MainHead
  {title}
  {description}
  {frontmatter}
  {robots} />

	<!-- <head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="/src/styles/styles.css">
    <link rel="preload" href="/fonts/commissioner-font.woff2" as="font" type="font/woff2" crossorigin />
		<title>Plants</title>
	</head> -->
	<body>
    <SlideInHeader />
    <Header />
		<slot />
    <!-- <slot>Some Text</slot> -->
    <Footer />
    <BackToTop />
    <script is:inline>
      function initDarkMode() {
        const switchBtn = document.querySelector('.switch-button');
        if (!switchBtn) return;

        let darkModeOn = JSON.parse(localStorage.getItem('mode')) || false;

        if (darkModeOn) {
          document.documentElement.classList.add('dark-mode');
          switchBtn.classList.add('slide');
        }

        switchBtn.addEventListener('click', () => {
          darkModeOn = !darkModeOn;
          document.documentElement.classList.toggle('dark-mode', darkModeOn);
          switchBtn.classList.toggle('slide', darkModeOn);
          localStorage.setItem('mode', JSON.stringify(darkModeOn));
        });
      }
      // toggle('class', condition); documentElement returns <html>
      initDarkMode();
      document.addEventListener('astro:page-load', initDarkMode);
    </script>
	</body>
</html>