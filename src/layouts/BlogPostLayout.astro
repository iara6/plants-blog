---
// component imports
import MainHead from "./MainHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import SlideInHeader from "../components/SlideInHeader.astro";
import PostHeader from "../components/PostHeader.astro";
import RelatedPosts from "../components/RelatedPosts.astro";
import CategoryCloud from "../components/CategoryCloud.astro";

// utils imports
import { formatBlogPosts } from "../js/utils";

const { frontmatter } = Astro.props;
const { title, description, date, category, author, image, robots } = frontmatter;

const allPosts = Object.values(
  import.meta.glob("../content/blog/*.md", { eager: true })
);

// const allPosts = await Astro.glob("../pages/blog/*.md"); DEPRECATED
const formattedPosts = formatBlogPosts(allPosts, {
  sortByDate: false,
});
const relatedPosts = formattedPosts
  .filter(
    (post) =>
      post.frontmatter.category.name.toLowerCase() === category.name.toLowerCase() &&
      post.frontmatter.title !== title
  )
  .slice(0, 4);
---

<!doctype html>
<html lang="ru">
  <MainHead {title} {description} {image} {frontmatter} robots={robots} />
	<body>
    <!-- <SlideInHeader /> -->
    <Header />
    <main class="post-container">
      <div class="post-container__content">
        <PostHeader {title} {date} {category} {author} />
        <div class="post-container__md-text">
          <slot />
        </div>
      </div>
      <div class="post-container__sidebar">
        <div class="post-container__sidebar-related">
          {
          relatedPosts.length > 0 && (
            <aside aria-label="Related posts">
              <RelatedPosts {relatedPosts} />
            </aside>
            )
          }
        </div>
        <div class="post-container__sidebar-categories">
          <h2 class="all-categories-h2">Все категории</h2>
          <div>
            <CategoryCloud /> <!-- showCount={true}  -->
          </div>
        </div>
      </div>
    </main>
    <Footer />
    <BackToTop />
    <script is:inline>
      function initDarkMode() {
        const switchBtn = document.querySelector('.switch-button');
        if (!switchBtn) return;

        let darkModeOn = JSON.parse(localStorage.getItem('mode')) || false;

        if (darkModeOn) {
          document.documentElement.classList.add('dark-mode');
          switchBtn.classList.add('slide');
        }

        switchBtn.addEventListener('click', () => {
          darkModeOn = !darkModeOn;
          document.documentElement.classList.toggle('dark-mode', darkModeOn);
          switchBtn.classList.toggle('slide', darkModeOn);
          localStorage.setItem('mode', JSON.stringify(darkModeOn));
        });
      }
      // toggle('class', condition); documentElement returns <html>
      initDarkMode();
      document.addEventListener('astro:page-load', initDarkMode);
    </script>
	</body>
</html>

<style>

  .post-container {
    display: grid;
    grid-template-columns: 1fr minmax(auto, 330px);
    gap: 1.5rem;
  }

  .post-container img {
    max-width: 100%;
    display: block;
    margin: 0 auto;
  }



  @media screen and (max-width:1400px) {
    .post-container {
      grid-template-columns: 1fr minmax(auto, 270px);
      /* gap: 1.5rem; */
    }
  }

  @media screen and (max-width:1200px) {
    .post-container {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr min-content;
    }
    .post-container__md-text {
      border: 2px solid hotpink;
      padding: 0 2rem;
    }
    .post-container__sidebar-related aside {
      display: grid;
      gap: 2rem;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    }
    .post-container__sidebar-categories :global(ul) {
      justify-content: center;
    }
  }
</style>