---
// component imports
import Seo from "../components/Seo.astro";

const {title, description, frontmatter, robots} = Astro.props;
---
  
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<!--   <link rel="icon" href="/favicon.ico" /> -->
  <link rel="stylesheet" href="/src/styles/styles.css"> <!-- IMPORT INSTEAD -->
  <meta name="generator" content={Astro.generator} />
  <link rel="preload" href="/fonts/commissioner-font.woff2" as="font" type="font/woff2" crossorigin />
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">

  <slot />

  <title>{title}</title>
  <meta name="description" content={description} />

  <Seo   
    {title}
    {description}
    url = {Astro.url}
    {frontmatter}
    {robots} />
</head>