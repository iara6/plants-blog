---
import MainLayout from "../layouts/MainLayout.astro";
import "../styles/styles.css";

const {
  title = "Результаты поиска",
  description = "Все результаты поиска по вашему запросу",
  robots = false,
  frontmatter,
} = Astro.props;
---

<MainLayout
  {title}
  {description}
  {frontmatter}
  {robots}
>
  <link slot="head" rel="stylesheet" href="/pagefind/pagefind-ui.css" />

  <main class="content-container">
    <div id="search"></div>
  </main>

  <script slot="body-end" src="/pagefind/pagefind-ui.js"  is:inline></script>
  <script slot="body-end" is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      const params = new URLSearchParams(window.location.search);
      const query = params.get("q");

      const ui = new PagefindUI({
        element: "#search",
        showSubResults: true,
      });

      if (query) {
        setTimeout(() => {
          const input = document.querySelector("#search input");

          if (input) {
            input.value = query;
            input.dispatchEvent(
              new Event("input", { bubbles: true })
            );
          }
        }, 150);
      }
    });
  </script>
</MainLayout>


