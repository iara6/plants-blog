---
// component imports
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="404 - Страница не найдена"
  description="Страница не найдена"
  robots={true}
>
  <main class="content-container content-container-404">
    <div class="container-404">
      <h1>404</h1>
      <h1>
        Страница не найдена :( 
      </h1>
      <p>
        Неверно указан адрес, или такой страницы не существует. 
      </p>
      <!-- <p>
        Поищите что-то еще.
      </p> -->
       <div class="home-button">
        <a href="/">
          На главную
        </a>
      </div>
    </div>
  </main>
</MainLayout>

<style>
  .content-container-404 {
    min-height: calc(100vh - 486px); /* hero + header + paddings + footer */
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .container-404 {
    /* border: 1px solid red; */
    padding: 2rem;
    display: grid;
    place-items: center;
  }
  .container-404 h1 {
    font-size: 2.3rem;
    font-weight: 600;
    text-align: center;
  }
  .container-404 p {
    margin-top: 1.2rem;
    font-size: 1.2rem;
    font-weight: 400;
    text-align: center;
  }
  .home-button {
    margin-top: 3rem;
  }
  .home-button a {
    background-color: var(--selection-clr);
    color: #442C2E;
    padding: 1rem 2rem;
    text-decoration: none;
    border-radius: 4px;
    font-size: 1.2rem;
    font-weight: 450;
  }

  @media screen and (max-width:1024px) {
    .container-404 h1 {
      font-size: 2rem;
    }
    .container-404 p {
      font-size: 1.1rem;
    }
    .home-button a {
      font-size: 1.1rem;
    }
  }

  @media screen and (max-width: 640px) {
    .container-404 h1 {
      font-size: 1.9rem;
    }
    .container-404 p {
      font-size: 1rem;
    }
    .home-button a {
      padding: 0.8rem 1.8rem;
      font-size: 1rem;
    }
  }

  @media screen and (max-width: 480px) {
    .container-404 h1 {
      font-size: 1.7rem;
    }
    .container-404 p {
      font-size: 1rem;
    }
    .home-button a {
      font-size: 1rem;
    }
  }
</style>