---
// component imports
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="404 - Страница не найдена"
  description="Страница не найдена"
  robots={true}
>
  <main class="content-container content-container-404">
    <div class="container-404">
      <h1>404</h1>
      <h1>
        Страница не найдена :(
      </h1>
      <p>
        Неверно указан адрес, или такой страницы не существует. 
      </p>
      <div class="container-404-buttons">
        <div class="home-button">
          <a href="/" title="На главную">
            <img src="/icons/home2.svg" alt="">
            На главную
          </a>
        </div>
        <div class="random-post-button">
          <a href="/blog/random" title="Случайная статья">
            <img src="/icons/dice2.svg" alt="">
            Случайная статья
          </a>
        </div>
      </div>
    </div>
  </main>
</MainLayout>

<style>
  .content-container-404 {
    min-height: calc(100vh - 486px); /* hero + header + paddings + footer */
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .container-404 {
    /* border: 1px solid red; */
    padding: 2rem;
    display: grid;
    place-items: center;
  }
  .container-404 h1 {
    font-size: 2.3rem;
    font-weight: 600;
    text-align: center;
  }
  .container-404 p {
    margin-top: 1.2rem;
    font-size: 1.2rem;
    font-weight: 400;
    text-align: center;
  }
  .container-404-buttons {
    display: flex;
    flex-direction: row;
    gap: 1rem;
  }
  .home-button,
  .random-post-button {
    margin-top: 3rem;
    /* display: flex;
    align-items: center; */
  }
  .home-button a,
  .random-post-button a {
    /* display: inline-block; */
    display: flex;
    align-items: center;
    background-color: var(--accent-clr-3);
    color: var(--text-clr-dark-perm);
    border: 1px solid var(--text-clr-dark);
    box-shadow: 2px 2px 0 0 var(--text-clr-dark);
    padding: 1rem 2rem;
    text-decoration: none;
    border-radius: 4px;
    font-size: 1.2rem;
    font-weight: 500;
    max-height: 57px;
  }
  .home-button a:hover,
  .random-post-button a:hover {
    transform: translate(2px, 2px);
    box-shadow: 0 0 0 var(--text-clr-dark);
  } 
  .home-button img,
  .random-post-button img {
    height: 24px;
    margin-right: 10px;
  }

  @media screen and (max-width:1024px) {
    .container-404 h1 {
      font-size: 2rem;
    }
    .container-404 p {
      font-size: 1.1rem;
    }
    .home-button a,
    .random-post-button a {
      font-size: 1.1rem;
    }
  }

  @media screen and (max-width: 640px) {
    .container-404 h1 {
      font-size: 1.9rem;
    }
    .container-404 p {
      font-size: 1rem;
    }
    .home-button a,
    .random-post-button a {
      padding: 0.8rem 1.8rem;
      font-size: 1rem;
    }
  }
  @media screen and (max-width: 530px) {
    .container-404-buttons {
      flex-direction: column;
      gap: 1rem;
    }
    .home-button {
      margin-top: 2rem;
    }
    .random-post-button {
      margin-top: 0;
    }
  }
  @media screen and (max-width: 480px) {
    .container-404 h1 {
      font-size: 1.7rem;
    }
    .container-404 p {
      font-size: 1rem;
    }
    .home-button a,
    .random-post-button a {
      font-size: 1rem;
    }
  }
</style>