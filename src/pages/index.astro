---
// component imports
import MainLayout from '../layouts/MainLayout.astro';
import PostCard from '../components/PostCard.astro';
import PostCardFeatured from '../components/PostCardFeatured.astro';
import PostCardSecondary from '../components/PostCardSecondary.astro';
import PostCardTrending from '../components/PostCardTrending.astro';

// utils imports
import { slugify, formatBlogPosts } from "../js/utils";

const allPosts = Object.values(
  import.meta.glob("../content/blog/*.md", { eager: true })
);
const formattedPosts = formatBlogPosts(allPosts);

const [featured, ...rest] = formattedPosts; 

const secondaryPosts = rest.slice(0, 3);
const allOtherPosts = rest.slice(3);

const visiblePosts = allOtherPosts.slice(0, 8);
const hiddenPosts = allOtherPosts.slice(8, 16);

const formattedTrendingPosts = formatBlogPosts(allOtherPosts, {
  sortByDate: false,
});

const trendingPosts = formattedTrendingPosts.slice(0, 7);
---

<MainLayout>
  <main class="content-container">
    <div class="home-main__new-articles-container">
      <section class="trending-section">
        <h2>Лучшее за месяц</h2>
        <div class="trending-section__contents-wrapper">
          {
            trendingPosts.map((post) => (
              <PostCardTrending frontmatter={post.frontmatter} url={`/blog/${slugify(post.frontmatter.title)}`} />
            ))
          }
        </div>
      </section>
      <section class="new-articles-section">
        <div class="new-articles-section__highlight">
          <PostCardFeatured frontmatter={featured.frontmatter} url={`/blog/${slugify(featured.frontmatter.title)}`} />
        </div>
        <div class="new-articles-section__secondary">
          {
            secondaryPosts.map((post) => (
              <PostCardSecondary frontmatter={post.frontmatter} url={`/blog/${slugify(post.frontmatter.title)}`} />
            ))
          }
        </div>
      </section>
    </div>
    <div class="home-main__all-container">
      <section>
        {
          visiblePosts.map((post) => (
            <PostCard frontmatter={post.frontmatter} url={`/blog/${slugify(post.frontmatter.title)}`} />
          ))
        }
        {
          hiddenPosts.map((post) => (
            <div class="hidden-post">
              <PostCard frontmatter={post.frontmatter} url={`/blog/${slugify(post.frontmatter.title)}`} />
            </div>
          ))
        }
      </section>

      <div class="show-more-button">
        <button>
          Смотреть ещё
        </button>
      </div>

      <div class="view-all-articles-button">
        <a href="/blog">
          Все статьи
        </a>
      </div>
    </div>
  </main>
</MainLayout>

<style>
  .home-main__new-articles-container {
    display: grid;
    grid-template-columns: 0.35fr 1fr;
    gap: 2rem;
  }
  p {
    color: var(--primary-clr-dark);
    padding: 2rem 0;
  }
  .trending-section {
    /* border: 2px solid lime; */
    padding-right: 1rem;
    border-right: 2px dashed rgb(185, 167, 167);
  }
  .trending-section h2 {
    font-size: 1.3rem;
    font-weight: 600;
    text-align: center;
    margin-top: 0.5rem;
  }
  .new-articles-section {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1.5rem;
  }
  .new-articles-section__secondary {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    /* border: 1px solid red; */
  }
  .home-main__all-container {
    margin-top: 2rem;
  }
  .home-main__all-container section {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  }
  .home-main__all-container .hidden-post {
    display: none;
  }
  .show-more-button {
    margin-top: 3rem;
    cursor: pointer;
    margin-inline: auto;
    width: fit-content;
  }
  .view-all-articles-button {
    display: none;
    margin-top: 3rem;
    justify-content: center;
  }
  .show-more-button button {
    border: none;
    cursor: pointer;
  }
  .view-all-articles-button a,
  .show-more-button button {
    background-color: var(--selection-clr);
    color: #442C2E;
    padding: 1rem 2rem;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: 4px;
    font-size: 1.1rem;
  }

  @media screen and (max-width:1200px) {
    .home-main__new-articles-container {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr min-content;
      grid-template-areas: 
      "new"
      "trending";
      gap: 2rem;
    }
    .new-articles-section {
      grid-area: new;
      /* display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 1.5rem; */
    }
    .trending-section {
      grid-area: trending;
      position: relative;
      border-right: none;
      border-top: 2px dashed rgb(185, 167, 167); 
      border-bottom: 2px dashed rgb(185, 167, 167); 
      min-width: 0;
      padding-right: 0;
    }
     .trending-section h2 {
      font-size: 1.5rem;
      font-weight: 600;
      text-align: center;
      margin: 1rem 0 0.8rem;
    }
    .trending-section__contents-wrapper {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 200px;
      overflow-x: scroll;
      margin-inline: -1.5rem;
      /* border: 1px solid red; */
    }
    .trending-section__contents-wrapper::after {
      content: "";
      position: absolute;
      top: 0px;
      bottom: 0px;
      right: -1.5rem;
      height: 100%;
      width: 3.75rem;
      background: linear-gradient(to left, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.3) 40%, rgba(255, 255, 255, 0) 100%) 0% 0% no-repeat content-box content-box rgba(0, 0, 0, 0);
      z-index: 1;
      pointer-events: none;
    }
  }
  

  /* Extra small devices (phones, 600px and down) */
@media only screen and (max-width: 600px) {...}

/* Small devices (portrait tablets and large phones, 600px and up) */
@media only screen and (min-width: 600px) {...}

/* Medium devices (landscape tablets, 768px and up) */
@media only screen and (min-width: 768px) {...}

/* Large devices (laptops/desktops, 992px and up) */
@media only screen and (min-width: 992px) {...}

/* Extra large devices (large laptops and desktops, 1200px and up) */
@media only screen and (min-width: 1200px) {...}

</style>

<script>
  const showMoreBtn = document.querySelector('.show-more-button');
  const viewAllBtn = document.querySelector('.view-all-articles-button');
  const hiddenPosts = document.querySelectorAll('.hidden-post');

  showMoreBtn.addEventListener('click', () => {
    hiddenPosts.forEach(post => post.style.display = 'block');
    showMoreBtn.style.display = 'none';
    viewAllBtn.style.display = 'flex';
  });
</script>