---
import BlogPostArticleLayout from "../../layouts/BlogPostArticleLayout.astro";
import { slugify } from "../../js/utils";

export async function getStaticPaths() {
 /*  const posts = Object.values(
    import.meta.glob("../../content/blog/*.md", { eager: true })
  ); */

 const posts = Object.values(
  import.meta.glob("../../content/**/*.md", { eager: true })
);


  return posts.map((post) => ({
    params: {
      category: post.frontmatter.category.slug,
      slug: slugify(post.frontmatter.title),
    },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
const Content = post.default;
---

<BlogPostArticleLayout frontmatter={post.frontmatter}>
  <Content />
</BlogPostArticleLayout>