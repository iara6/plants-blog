---
// component imports
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleGroup from "../../components/ArticleGroup.astro";

// utils imports
import { formatBlogPosts } from "../../js/utils";

const allPosts = Object.values(
  import.meta.glob("/src/content/komnatnye-rasteniya/*.md", { eager: true })
);

const formattedPosts = formatBlogPosts(allPosts);
/* const [featured, ...rest] = formattedPosts; 
const secondaryPosts = rest.slice(0, 4); */

const groups = [];

for (let i = 0; i < formattedPosts.length; i += 5) {
  const chunk = formattedPosts.slice(i, i + 5);

  const groupIndex = Math.floor(i / 5);
  const featuredOnLeft = groupIndex % 2 === 0;

  if (groupIndex > 0 && chunk.length < 5) {
    groups.push({
      featured: null,
      secondary: chunk,
      featuredOnLeft,
    });

    continue;
  }

  groups.push({
    featured: featuredOnLeft
      ? chunk[0]
      : chunk[4],

    secondary: featuredOnLeft
      ? chunk.slice(1)
      : chunk.slice(0, 4),

    featuredOnLeft,
  });
}

const {
  title = "Комнатные растения",
  description = "Все о комнатных растениях",
  robots = true,
  frontmatter,
} = Astro.props;

---

<MainLayout
  {title}
  {description}
  {frontmatter}
  {robots}
>
  <main class="content-container">
    <h1 class="page-title">Все о домашних растениях</h1>
    <!-- <section class="menu-section-articles-container">
      <div class="menu-section__highlight">
        <PostCardFeatured frontmatter={featured.frontmatter} url={`/${featured.frontmatter.category.slug}/${slugify(featured.frontmatter.title)}`} />
      </div>
      <div class="menu-section__secondary">
        {
          secondaryPosts.map((post) => (
            <PostCard frontmatter={post.frontmatter} url={`/${post.frontmatter.category.slug}/${slugify(post.frontmatter.title)}`} />
          ))
        }
      </div>
    </section> -->
    {
      groups.map((group) => (
        <ArticleGroup
          featured={group.featured}
          secondary={group.secondary}
          featuredOnLeft={group.featuredOnLeft}
        />
      ))
    }
  </main>
</MainLayout>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 600;
    color: var(--text-clr-dark);
    margin-bottom: 2rem;
  }
</style>
