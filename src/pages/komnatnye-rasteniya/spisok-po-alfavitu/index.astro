---
// component imports
import MainLayout from "../../../layouts/MainLayout.astro";
import ArticleGroup from "../../../components/ArticleGroup.astro";

// utils imports
import { formatBlogPosts, slugify } from "../../../js/utils";
import { letters } from "../../../js/alphabet";

const allPlants = Object.values(
  import.meta.glob("/src/content/komnatnye-rasteniya/spisok-po-alfavitu/*/*.md", {
    eager: true,
  })
);

const formattedPlants = formatBlogPosts(allPlants);

const {
  title = "Список домашних растений по алфавиту",
  description = "Список домашних растений по алфавиту",
  robots = true,
  frontmatter,
} = Astro.props;

---

<MainLayout
  {title}
  {description}
  {frontmatter}
  {robots}
>
  <main class="content-container" data-pagefind-body>
    <h1 class="page-title">Названия комнатных растений по алфавиту</h1>
    <div class="alphabet-container">
      <ul class="alphabet-ulist">
        {letters.map(({ letter, slug }) => (
          <li>
            <a href={`/komnatnye-rasteniya/spisok-po-alfavitu/${slug}/`}>
          {letter}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- <div class="alphabet-block" id="А">	
      <span class="alphabet-block-letter">А</span>
      <ul class="alphabet-list">
        <li><a href="#">Абутилон</a></li>
        <li><a href="#">Аглаонема</a></li>                      			
      </ul>
    </div> -->

  {
  letters.map(({ letter, slug }) => {
    const plantsForLetter = formattedPlants
      .filter((plant) => plant.frontmatter.plant?.charAt(0).toLowerCase() === letter.toLowerCase())
      .sort((a, b) =>
        a.frontmatter.plant.localeCompare(b.frontmatter.plant, "ru")
      );

    if (plantsForLetter.length === 0) {
      return null;
    }

    return (
      <div class="alphabet-block" id={letter}>
        <span class="alphabet-block-letter">{letter}</span>

        <ul class="alphabet-list">
          {plantsForLetter.map((plant) => (
            <li>
              <a
                href={`/${plant.frontmatter.category.slug}/${slugify(plant.frontmatter.title)}`}
              >
                {plant.frontmatter.plant}
              </a>
            </li>
          ))}
        </ul>
      </div>
    );
  })
}

    <!-- <div class="alphabet-block" id="Б">	
      <span class="alphabet-block-letter">Б</span>
      <ul class="alphabet-list">
        <li><a href="#">Баклажан</a></li>
        <li><a href="#">Бамбук</a></li>
        <li><a href="#">Банановое дерево</a></li>
        <li><a href="#">Бегония</a></li>
        <li><a href="#">Берёза</a></li>
        <li><a href="#">Бересклет</a></li>
        <li><a href="#">Бонсай</a></li>                			
      </ul>
    </div> -->
   
    <!--  {
      groups.map((group) => (
        <ArticleGroup
          featured={group.featured}
          secondary={group.secondary}
          featuredOnLeft={group.featuredOnLeft}
        />
      ))
    } -->
  </main>
</MainLayout>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 600;
    color: var(--text-clr-dark);
    margin-bottom: 2rem;
  }
  .alphabet-container {
    margin: 2.5rem 0 3.5rem;
  }
  .alphabet-ulist {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
  }
  .alphabet-ulist li {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .alphabet-ulist a {
    text-decoration: none;
    color: var(--text-clr-dark);
    font-size: 1.4rem;
    font-weight: 450;
    height: 3.25rem;
    width: 3.25rem;
    border: 1px solid rgba(153, 152, 152, 0.5);
    margin-top: -1px;
    margin-left: -1px;
    display: flex;
    justify-content: center;
    align-items: center;
    transition: all 150ms ease-out;
  }
  .alphabet-ulist a:hover {
    background-color: var(--accent-clr-4);
    color: var(--text-clr-dark-perm);
  }
  .alphabet-block {
    margin-top: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1.5px solid rgba(153, 152, 152, 0.5);
  }
  .alphabet-block-letter {
    color: var(--text-clr-links);
    font-size: 2.4rem;
    font-weight: 500;
    display: block;
    margin-bottom: 1.5rem;
  }
  .alphabet-list {
    column-count: 3;
    /* display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px 2rem; */
  }
  .alphabet-list li {
    margin-left: 1.5rem;
    list-style: none;
    line-height: 1.8;
  }
  .alphabet-list a {
    text-decoration: none;
    color: var(--text-clr-dark);
    font-size: 1.1rem;
    transition: all 150ms ease-out;
  }
  .alphabet-list a:hover {
    filter: brightness(4);
  }

  @media screen and (max-width:1024px) {
    .alphabet-ulist a {
      font-size: 1.3rem;
      height: 3.2rem;
      width: 3.2rem;
    }
  }
  @media screen and (max-width:768px) {
    .alphabet-list {
      column-count: 2;
    }
    .alphabet-ulist a {
      font-size: 1.2rem;
      height: 3rem;
      width: 3rem;
    }
    .alphabet-block-letter {
      font-size: 2.3rem;
    }
  }
  @media screen and (max-width: 640px) {
    .alphabet-list li {
      line-height: 1.9;
    }
    .alphabet-ulist a {
      font-size: 1.1rem;
      height: 2.8rem;
      width: 2.8rem;
    }
    .alphabet-block-letter {
      font-size: 2rem;
    }
    .alphabet-list a {
      font-size: 1rem;
    }
  }

</style>

