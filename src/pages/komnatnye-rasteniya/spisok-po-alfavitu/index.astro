---
// component imports
import MainLayout from "../../../layouts/MainLayout.astro";
import ArticleGroup from "../../../components/ArticleGroup.astro";

// utils imports
import { formatBlogPosts } from "../../../js/utils";

const allPosts = Object.values(
  import.meta.glob("/src/content/komnatnye-rasteniya/spisok-po-alfavitu/*.md", { eager: true })
);

const formattedPosts = formatBlogPosts(allPosts);

const groups = [];

for (let i = 0; i < formattedPosts.length; i += 5) {
  const chunk = formattedPosts.slice(i, i + 5);

  const groupIndex = Math.floor(i / 5);
  const featuredOnLeft = groupIndex % 2 === 0;

  if (groupIndex > 0 && chunk.length < 5) {
    groups.push({
      featured: null,
      secondary: chunk,
      featuredOnLeft,
    });

    continue;
  }

  groups.push({
    featured: featuredOnLeft
      ? chunk[0]
      : chunk[4],

    secondary: featuredOnLeft
      ? chunk.slice(1)
      : chunk.slice(0, 4),

    featuredOnLeft,
  });
}

const letters = [
  { letter: 'А', slug: 'a' },
  { letter: 'Б', slug: 'b' },
  { letter: 'В', slug: 'v' },
  { letter: 'Г', slug: 'g' },
  { letter: 'Д', slug: 'd' },
  { letter: 'Е', slug: 'e' },
  { letter: 'Ж', slug: 'zh' },
  { letter: 'З', slug: 'z' },
  { letter: 'И', slug: 'i' },
  { letter: 'К', slug: 'k' },
  { letter: 'Л', slug: 'l' },
  { letter: 'М', slug: 'm' },
  { letter: 'Н', slug: 'n' },
  { letter: 'О', slug: 'o' },
  { letter: 'П', slug: 'p' },
  { letter: 'Р', slug: 'r' },
  { letter: 'С', slug: 's' },
  { letter: 'Т', slug: 't' },
  { letter: 'У', slug: 'u' },
  { letter: 'Ф', slug: 'f' },
  { letter: 'Х', slug: 'h' },
  { letter: 'Ц', slug: 'ts' },
  { letter: 'Ч', slug: 'ch' },
  { letter: 'Ш', slug: 'sh' },
  { letter: 'Э', slug: 'eh' },
  { letter: 'Ю', slug: 'yu' },
  { letter: 'Я', slug: 'ya' },
