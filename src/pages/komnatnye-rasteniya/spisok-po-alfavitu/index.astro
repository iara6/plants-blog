const letters = [
  { letter: 'А', slug: 'a' },
  { letter: 'Б', slug: 'b' },
  { letter: 'В', slug: 'v' },
  { letter: 'Г', slug: 'g' },
  { letter: 'Д', slug: 'd' },
  { letter: 'Е', slug: 'e' },
  { letter: 'Ж', slug: 'zh' },
  { letter: 'З', slug: 'z' },
  { letter: 'И', slug: 'i' },
  { letter: 'К', slug: 'k' },
  { letter: 'Л', slug: 'l' },
  { letter: 'М', slug: 'm' },
  { letter: 'Н', slug: 'n' },
  { letter: 'О', slug: 'o' },
  { letter: 'П', slug: 'p' },
  { letter: 'Р', slug: 'r' },
  { letter: 'С', slug: 's' },
  { letter: 'Т', slug: 't' },
  { letter: 'У', slug: 'u' },
  { letter: 'Ф', slug: 'f' },
  { letter: 'Х', slug: 'h' },
  { letter: 'Ц', slug: 'ts' },
  { letter: 'Ч', slug: 'ch' },
  { letter: 'Ш', slug: 'sh' },
  { letter: 'Э', slug: 'eh' },
  { letter: 'Ю', slug: 'yu' },
  { letter: 'Я', slug: 'ya' },
];

const {
  title = "Список домашних растений по алфавиту",
  description = "Список домашних растений по алфавиту",
  robots = true,
  frontmatter,
} = Astro.props;

---

<MainLayout
  {title}
  {description}
  {frontmatter}
  {robots}
>
  <main class="content-container">
    <h1 class="page-title">Названия комнатных растений по алфавиту</h1>
    <div class="alphabet-container">
      <ul class="alphabet-ulist">
        {letters.map(({ letter, slug }) => (
          <li>
            <a href={`/komnatnye-rasteniya/spisok-po-alfavitu/${slug}/`}>
          {letter}
            </a>
          </li>
        ))}
       <!--  <li><a href="">А</a></li>
        <li><a href="">Б</a></li>
        <li><a href="">В</a></li>
        <li><a href="">Г</a></li>
        <li><a href="">Д</a></li>
        <li><a href="">Е</a></li>
        <li><a href="">Ж</a></li>
        <li><a href="">З</a></li>
        <li><a href="">И</a></li>
        <li><a href="">К</a></li>
        <li><a href="">Л</a></li>
        <li><a href="">М</a></li>
        <li><a href="">Н</a></li>
        <li><a href="">О</a></li>
        <li><a href="">П</a></li>
        <li><a href="">Р</a></li>
        <li><a href="">С</a></li>
        <li><a href="">Т</a></li>
        <li><a href="">У</a></li>
        <li><a href="">Ф</a></li>
        <li><a href="">Х</a></li>
        <li><a href="">Ц</a></li>
        <li><a href="">Ч</a></li>
        <li><a href="">Ш</a></li>
        <li><a href="">Э</a></li>
        <li><a href="">Ю</a></li>
        <li><a href="">Я</a></li> -->
      </ul>

    </div>

    <!-- <div class="alphabet-block" id="А">	
      <span class="alphabet-block-letter">А</span>
      <ul class="alphabet-list">
        <li><a href="#">Абутилон</a></li>
        <li><a href="#">Аглаонема</a></li>                      			
      </ul>
    </div> -->

    {
  letters.map(({ letter, slug }) => {
    const plantsForLetter = formattedPlants
      .filter((plant) => plant.frontmatter.plant?.charAt(0).toLowerCase() === letter.toLowerCase())
      .sort((a, b) =>
        a.frontmatter.plant.localeCompare(b.frontmatter.plant, "ru")
      );

    if (plantsForLetter.length === 0) {
      return null;
    }

    return (
      <div class="alphabet-block" id={letter}>
        <span class="alphabet-block-letter">{letter}</span>

        <ul class="alphabet-list">
          {plantsForLetter.map((plant) => (
            <li>
              <a
                href={`/${plant.frontmatter.category.slug}/${slugify(plant.frontmatter.title)}`}
              >
                {plant.frontmatter.plant}
              </a>
            </li>
          ))}
        </ul>
      </div>
    );
  })
}

