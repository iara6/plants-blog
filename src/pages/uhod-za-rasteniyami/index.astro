---
// component imports
import MainLayout from "../../layouts/MainLayout.astro";
import PostCard from '../../components/PostCard.astro';
import PostCardFeatured from '../../components/PostCardFeatured.astro';
import PostCardSecondary from "../../components/PostCardSecondary.astro";
import ArticleGroup from "../../components/ArticleGroup.astro";

// utils imports
import { slugify, formatBlogPosts } from "../../js/utils";

const allPosts = Object.values(
  import.meta.glob("/src/content/uhod/*.md", { eager: true })
);

const formattedPosts = formatBlogPosts(allPosts);
const [featured, ...rest] = formattedPosts; 

const secondaryPosts = rest.slice(0, 4);
/* ******** */
const groups = [];

for (let i = 0; i < formattedPosts.length; i += 5) {
  const chunk = formattedPosts.slice(i, i + 5);

  if (chunk.length === 0) continue;

  const evenGroup = Math.floor(i / 5) % 2 === 1;

  groups.push({
    featured: evenGroup
      ? chunk[chunk.length - 1]
      : chunk[0],

    secondary: evenGroup
      ? chunk.slice(0, chunk.length - 1)
      : chunk.slice(1),

    featuredOnLeft: !evenGroup,
  });
}
/* ********* */


const {
  title = "Все об уходе",
  description = "Все об уходе за домашними растениями",
  robots = true,
  frontmatter,
} = Astro.props;

---

<MainLayout
  {title}
  {description}
  {frontmatter}
  {robots}
>
  <main class="content-container">
    <h1>Все об уходе за домашними растениями</h1>
    <!-- <section class="menu-section-articles-container">
      <div class="menu-section__highlight">
        <PostCardFeatured frontmatter={featured.frontmatter} url={`/${featured.frontmatter.category.slug}/${slugify(featured.frontmatter.title)}`} />
      </div>
      <div class="menu-section__secondary">
        {
          secondaryPosts.map((post) => (
            <PostCard frontmatter={post.frontmatter} url={`/${post.frontmatter.category.slug}/${slugify(post.frontmatter.title)}`} />
          ))
        }
      </div>
    </section> -->
    {
      groups.map((group) => (
        <ArticleGroup
          featured={group.featured}
          secondary={group.secondary}
          featuredOnLeft={group.featuredOnLeft}
        />
      ))
    }
  </main>
</MainLayout>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 600;
    color: var(--text-clr-dark);
    margin-bottom: 2rem;
  }
  .menu-section-articles-container {
    display: grid;
    grid-template-columns: 1.5fr 2fr;
    gap: 1.5rem;
  }
  .menu-section__secondary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 1.5rem;
  }
</style>
