---
// component imports
import MainLayout from "../../layouts/MainLayout.astro";
import ArticleGroup from "../../components/ArticleGroup.astro";

// utils imports
import { formatBlogPosts } from "../../js/utils";

const allPosts = Object.values(
  import.meta.glob("/src/content/zdorove/*.md", { eager: true })
);

const formattedPosts = formatBlogPosts(allPosts);

const groups = [];

for (let i = 0; i < formattedPosts.length; i += 5) {
  const chunk = formattedPosts.slice(i, i + 5);

  if (chunk.length === 0) continue;

  const evenGroup = Math.floor(i / 5) % 2 === 1;

  groups.push({
    featured: evenGroup
      ? chunk[chunk.length - 1]
      : chunk[0],

    secondary: evenGroup
      ? chunk.slice(0, chunk.length - 1)
      : chunk.slice(1),

    featuredOnLeft: !evenGroup,
  });
}

const {
  title = "Все о здоровье",
  description = "Все о здоровье домашних растений",
  robots = true,
  frontmatter,
} = Astro.props;
---

<MainLayout
  {title}
  {description}
  {frontmatter}
  {robots}
>
  <main class="content-container">
    <h1>Здоровье растений</h1>
     {
      groups.map((group) => (
        <ArticleGroup
          featured={group.featured}
          secondary={group.secondary}
          featuredOnLeft={group.featuredOnLeft}
        />
      ))
    }
  </main>
</MainLayout>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 600;
    color: var(--text-clr-dark);
    margin-bottom: 2rem;
  }
</style>
