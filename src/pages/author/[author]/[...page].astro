---
// component imports
import MainLayout from "../../../layouts/MainLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import CategoryCloud from "../../../components/CategoryCloud.astro";
import RightArrow from "../../../components/icons/RightArrow.astro";
import LeftArrow from "../../../components/icons/LeftArrow.astro";

// utils imports
import { slugify, formatBlogPosts } from '../../../js/utils';

export async function getStaticPaths({ paginate }) {
  /* const allPosts = Object.values(
    import.meta.glob("/src/content/blog/*.md", { eager: true })
  ); */

   const allPosts = Object.values(
  import.meta.glob("/src/content/**/*.md", { eager: true })
);


  const formattedPosts = formatBlogPosts(allPosts);

  const allAuthors = [
    ...new Map(
      formattedPosts.map((post) => [
        post.frontmatter.author.slug,
        post.frontmatter.author,
      ])
    ).values(),
  ];

  return allAuthors.flatMap((author) => {
    const authorPosts = formattedPosts.filter((post) => post.frontmatter.author.slug === author.slug);

    return paginate(authorPosts, {
      params: { author: author.slug},
      props: {
        authorName: author.name,
      },
      pageSize: 12,
    });
  });
}

const { page, posts, authorName } = Astro.props;
---

<MainLayout
  title={`Автор: ${authorName}`}
  description={`Статьи автора ${authorName}`}
>
  <main class="content-container">
    <h1>Статьи автора <span class="highlight">{authorName}</span></h1>
    <div class="author-page-container" aria-label={`Статьи автора ${authorName}`}>
      <div class="author-posts-container">
        {
          page.data.map((post) => (
            <PostCard frontmatter={post.frontmatter} url={`/${post.frontmatter.category.slug}/${slugify(post.frontmatter.title)}`} />
          ))
        }
      </div>
    </div>

    <div class="pagination-buttons">
      {page.url.prev && <a href={page.url.prev}>
        <LeftArrow
          class="pagination-icon"
          aria-hidden="true" />
         Назад
         </a>}
      {page.url.next && <a href={page.url.next}>
        Вперёд 
        <RightArrow
          class="pagination-icon"
          aria-hidden="true" />
        </a>}
    </div>
    <p class="page-number">
      Страница {page.currentPage} из {page.lastPage}
    </p>
    <h2 class="all-categories-h2">Все категории</h2>
    <div class="category-cloud-container">
      <CategoryCloud showCount={true} />
    </div>
  </main>
</MainLayout>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 600;
    color: var(--text-clr-dark);
    margin-bottom: 2rem;
  }
  .highlight {
    color: var(--accent-clr) !important;
  }
  .author-posts-container {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  @media screen and (max-width: 688px) { 
    .author-posts-container {
      gap: 1rem;
      grid-template-columns: 1fr;
      border: 1px solid black;
      padding: 0 4.5rem;
    }
  }

  @media screen and (max-width: 600px) { 
    .author-posts-container {
      border: 1px solid rgb(231, 2, 2);
      padding: 0 3.5rem;
    }
  }

  @media screen and (max-width: 550px) { 
    .author-posts-container {
      border: 1px solid rgb(7, 255, 20);
      padding: 0;
    }
  }
</style>