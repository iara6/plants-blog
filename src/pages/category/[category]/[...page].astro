---
// component imports
import MainLayout from "../../../layouts/MainLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import CategoryCloud from "../../../components/CategoryCloud.astro";
import RightArrow from "../../../components/icons/RightArrow.astro";
import LeftArrow from "../../../components/icons/LeftArrow.astro";

// utils imports
import { slugify, formatBlogPosts } from '../../../js/utils';

export async function getStaticPaths({ paginate }) {
 /*  const allPosts = Object.values(
    import.meta.glob("/src/content/blog/*.md", { eager: true })
  ); */

 const allPosts = Object.values(
  import.meta.glob("/src/content/**/*.md", { eager: true })
);


  const formattedPosts = formatBlogPosts(allPosts);

  return [
    {
      params: { category: "poleznoe" },
      props: { name: "Полезное" },
    },
    {
      params: { category: "sovety" },
      props: { name: "Советы" },
    },
    {
      params: { category: "otdyh" },
      props: { name: "Отдых" },
    },
    {
      params: { category: "priroda" },
      props: { name: "Природа" },
    },
    {
      params: { category: "zhizn" },
      props: { name: "Жизнь" },
    },
    {
      params: { category: "zdorove" },
      props: { name: "Здоровье" },
    },
    {
      params: { category: "uhod" },
      props: { name: "Уход" },
    },
    {
      params: { category: "podbor-rastenij" },
      props: { name: "Подбор растений" },
    },
  ].flatMap(({ params, props }) => {
    const categoryPosts = formattedPosts.filter(
      (post) => post.frontmatter.category?.slug === params.category
    );

     if (categoryPosts.length === 0) return [];

    return paginate(categoryPosts, {
      params,
      props,
      pageSize: 12,
    });
  });
}

const { page, name } = Astro.props;
---

<MainLayout
  title={`Категория: ${name}`}
  description={`Статьи по тегу ${name.toLowerCase()}`}
>
  <main class="content-container">
    <h1>Статьи по тегу <span class="highlight">{name?.toLowerCase()}</span></h1>
    <div class="category-page-container" aria-label={`Статьи по тегу ${name}`}>
      <div class="category-posts-container">
        {
          page.data.map((post) => (
            <PostCard frontmatter={post.frontmatter} url={`/${post.frontmatter.category.slug}/${slugify(post.frontmatter.title)}`} />
          ))
        }
      </div>
    </div>

    <div class="pagination-buttons">
      {page.url.prev && <a href={page.url.prev}>
        <LeftArrow
          class="pagination-icon"
          aria-hidden="true" />
         Назад
         </a>}
      {page.url.next && <a href={page.url.next}>
        Вперёд 
        <RightArrow
          class="pagination-icon"
          aria-hidden="true" />
        </a>}
    </div>
    <p class="page-number">
      Страница {page.currentPage} из {page.lastPage}
    </p>
    <h2 class="all-categories-h2">Все категории</h2>
    <div class="category-cloud-container">
      <CategoryCloud showCount={true} />
    </div>
  </main>
</MainLayout>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 600;
    color: var(--text-clr-dark);
    margin-bottom: 2rem;
  }
  .highlight {
    color: var(--accent-clr) !important;
  }
  .category-posts-container {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }
/* 672px */
  @media screen and (max-width: 688px) { 
    .category-posts-container {
      gap: 1rem;
      grid-template-columns: 1fr;
      border: 1px solid black;
      padding: 0 4.5rem;
    }
  }

  @media screen and (max-width: 600px) { 
    .category-posts-container {
      border: 1px solid rgb(231, 2, 2);
      padding: 0 3.5rem;
    }
  }

  @media screen and (max-width: 550px) { 
    .category-posts-container {
      border: 1px solid rgb(7, 255, 20);
      padding: 0;
    }
  }

</style>