---
// component imports
import MainLayout from "../../../layouts/MainLayout.astro";
import PostCard from "../../../components/PostCard.astro";
import CategoryCloud from "../../../components/CategoryCloud.astro";

// utils imports
import { slugify, formatBlogPosts } from '../../../js/utils';

export async function getStaticPaths({ paginate }) {

  const allPosts = Object.values(
    import.meta.glob("/src/content/blog/*.md", { eager: true })
  );

  const formattedPosts = formatBlogPosts(allPosts);

  
  return [
    {
      params: { category: "poleznoe" },
      props: { name: "Полезное" },
    },
    {
      params: { category: "sovety" },
      props: { name: "Советы" },
    },
    {
      params: { category: "otdyh" },
      props: { name: "Отдых" },
    },
    {
      params: { category: "priroda" },
      props: { name: "Природа" },
    },
    {
      params: { category: "zhizn" },
      props: { name: "Жизнь" },
    },
  ].flatMap(({ params, props }) => {
    const categoryPosts = formattedPosts.filter(
      (post) => post.frontmatter.category?.slug === params.category
    );

     if (categoryPosts.length === 0) return [];

    return paginate(categoryPosts, {
      params,
      props,
      pageSize: 9,
    });
  });
}

const { page, name } = Astro.props;

---

<MainLayout
  title={`Категория: ${name}`}
  description={`Статьи по тегу ${name.toLowerCase()}`}
>
  <main class="content-container">
    <h1>Статьи по тегу <span class="highlight">{name?.toLowerCase()}</span></h1>
    <div class="category-page-container" aria-label={`Статьи по тегу ${name}`}>
      
      <div class="category-posts-container">
        {
          page.data.map((post) => (
            <PostCard frontmatter={post.frontmatter} url={`/blog/${slugify(post.frontmatter.title)}`} />
          ))
        }
      </div>
    </div>

    <div class="pagination-buttons">
      {page.url.prev && <a href={page.url.prev}>
        <img src="/icons/left.svg" alt="">
         Назад
         </a>}
      {page.url.next && <a href={page.url.next}>
        Вперёд <img src="/icons/right.svg" alt="">
        </a>}
    </div>
    <p class="page-number">
      Страница {page.currentPage} из {page.lastPage}
    </p>
    <h2 class="all-categories-h2">Все категории</h2>
    <div class="category-cloud-container">
      <CategoryCloud showCount={true} />
    </div>
  </main>
</MainLayout>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 600;
    color: var(--primary-clr-dark);
    margin-bottom: 2rem;
  }
  .highlight {
    color: var(--accent-clr) !important;
  }
  .category-posts-container {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
  }
</style>