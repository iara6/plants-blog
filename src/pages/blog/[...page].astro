---
// component imports
import MainLayout from "../../layouts/MainLayout.astro";
import PostCard from "../../components/PostCard.astro";
import CategoryCloud from "../../components/CategoryCloud.astro";
import RightArrow from "../../components/icons/RightArrow.astro";
import LeftArrow from "../../components/icons/LeftArrow.astro";

// utils imports
import { slugify, formatBlogPosts } from '../../js/utils';

export async function getStaticPaths({ paginate }) {
 /*  const allPosts = Object.values(
    import.meta.glob("../../content/blog/*.md", { eager: true })
  ); */

  const allPosts = Object.values(
  import.meta.glob("../../content/**/*.md", { eager: true })
);


  const formattedPosts = formatBlogPosts(allPosts);

  return paginate(formattedPosts, { 
    pageSize: 12 /* posts per page */
  });
}

const { page } = Astro.props;
---

<MainLayout>
  <main class="content-container">
    <h1>Все статьи сайта</h1>
    <div class="all-posts-container">
      {
        page.data.map((post) => (
          <PostCard frontmatter={post.frontmatter} url={`/${post.frontmatter.category.slug}/${slugify(post.frontmatter.title)}`} />
        ))
      }
    </div>
    <div class="pagination-buttons">
      {page.url.prev && <a href={page.url.prev}>
        <LeftArrow
          class="pagination-icon"
          aria-hidden="true" />
         Назад
         </a>}
      {page.url.next && <a href={page.url.next}>
        Вперед
        <RightArrow
          class="pagination-icon"
          aria-hidden="true" />
        </a>}
    </div>
    <p class="page-number">
      Страница {page.currentPage} из {page.lastPage}
    </p>
    <h2 class="all-categories-h2">Все категории</h2>
    <div class="category-cloud-container">
      <CategoryCloud showCount={true} />
    </div>
  </main>
</MainLayout>

<style>
  h1 {
    font-size: 2rem;
    font-weight: 600;
    color: var(--text-clr-dark);
    margin-bottom: 2rem;
  }
  .all-posts-container {
    display: grid;
    gap: 1.5rem;
    /* grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); */
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  }

  @media screen and (max-width: 688px) { 
    .all-posts-container {
      gap: 1rem;
      grid-template-columns: 1fr;
      border: 1px solid black;
      padding: 0 4.5rem;
    }
  }

  @media screen and (max-width: 600px) { 
    .all-posts-container {
      border: 1px solid rgb(231, 2, 2);
      padding: 0 3.5rem;
    }
  }

  @media screen and (max-width: 550px) { 
    .all-posts-container {
      border: 1px solid rgb(7, 255, 20);
      padding: 0;
    }
  }

</style>