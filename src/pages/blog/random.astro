---
import { slugify } from "../../js/utils";

/* const posts = Object.values(
  import.meta.glob("../../content/blog/*.md", { eager: true })
); */

const posts = Object.values(
  import.meta.glob("../../content/**/*.md", { eager: true })
);

const urls = posts.map(post =>
  `/${post.frontmatter.category.slug}/${slugify(post.frontmatter.title)}`
);
---

<script define:vars={{ urls }}>
  const randomPost = urls[Math.floor(Math.random() * urls.length)];

  window.location.replace(randomPost);
</script>