---
// utils imports
import { formatDate } from "../js/utils";

const { frontmatter, url } = Astro.props;

const { title, description, date, category, author, image } = frontmatter;
---

<div class="featured-post">
  <a class="featured__img-link" href={url}>
    <img class="featured-post-image" src={image.src} alt={image.alt}>
  </a>
  <div>
    <h3 class="featured-title">
      <a href={url}>{title}</a>
    </h3>
    <span class="featured-data">
      <span class="featured-post-date">{formatDate(date)}</span> • <a href={`/author/${author.slug}/`}>{author.name}</a> • <span class="article-category"><a href={`/category/${category.slug}/`}>{category.name}</a></span>
    </span>
    <p class="featured__description">{description}</p>
  </div>
</div>

<style>
  .featured-post a {
    color: var(--text-clr-dark);
    text-decoration: none;
  }
  .featured-post h3 {
    font-size: 1.65rem;
    font-weight: 600;
    margin: 1.5rem 0 0.4rem;
  }
  .featured__img-link {
    display: block;
    width: 100%;
    height: 600px;
  }
  .featured__img-link img {
    width: 100%;
    height: 100%;
    border-radius: 6px;
    object-fit: cover;
  }
  .featured-post span {
    color: var(--text-clr-dark-m);
  }
  .featured-post-date {
    font-size: 0.95rem;
  }
  .featured-data a {
    color: var(--text-clr-dark-m);
  }
  .featured__description {
    font-size: 1.2rem;
    font-weight: 400;
    margin-top: 1rem;
  }

  @media screen and (max-width: 1024px) {
    .featured__img-link {
      height: 550px;
    }
  }
  @media screen and (max-width: 768px) {
    .featured__img-link {
      height: 450px;
    }
    .featured-post span {
      font-size: 0.95rem;
    }
    .featured-post-date {
      font-size: 0.85rem !important;
    }
    .featured__description {
      font-size: 1.1rem;
      margin-top: 1rem;
    }
  }
  @media screen and (max-width: 720px) {
    .featured-post h3 {
      margin: 0.5rem 0 0.5rem;
    }
  }
  @media screen and (max-width: 688px) {
    .featured-post {
      width: 100%;
    }
    .featured__img-link {
      height: 400px;
    }
    .featured-post h3 {
      font-size: 1.2rem;
      margin: 0;
      padding: 0.5rem 0 0.4rem;
    }
    .featured__description {
      font-size: 1rem;
      margin-top: 0.5rem;
    }
  }
  @media screen and (max-width: 650px) {
    .featured__img-link {
      height: 350px;
    }
  }
   @media screen and (max-width: 320px) {
    .featured__img-link {
      height: 250px;
    }
  }
  @media screen and (max-width: 270px) {
    .featured__img-link {
      height: 210px;
    }
  }

</style>