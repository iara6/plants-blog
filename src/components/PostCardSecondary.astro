---
// utils imports
import { formatDate } from "../js/utils";

const { frontmatter, url } = Astro.props;

const { title, description, date, category, author, image } = frontmatter;
---

<div class="secondary-post">
  <a class="secondary__img-link" href={url}>
    <img class="secondary-post-image" src={image.src} alt={image.alt}>
  </a>
  <div>
    <h3>
      <a href={url}>{title}</a>
    </h3>
    <span>
      <span class="secondary-post-date">{formatDate(date)}</span> • <a href={`/author/${author.slug}/`}>{author.name}</a>
    </span>
<!--     
    <p class="secondary__description">{description}</p> -->
  </div>
</div>

<style>
  .secondary-post a {
    color: var(--primary-clr-dark);
    text-decoration: none;
  }
  .secondary-post h3 {
    font-size: 1.35rem;
    font-weight: 600;
    padding: 0.5rem 0 0.4rem;
  }
  .secondary-post-date {
    font-size: 0.9rem;
  }
  .secondary__img-link {
    display: block;
    width: 100%;
    height: 230px;
  }
  .secondary__img-link img {
    width: 100%;
    height: 100%;
    border-radius: 6px;
    object-fit: cover;
  }
  .secondary__description {
    font-size: 1.1rem;
    font-weight: 300;
  }
  .secondary-post span {
    opacity: 0.9;
  }

  @media screen and (max-width: 768px) {
    .secondary-post h3 {
      font-size: 1.2rem;
      /*  font-weight: 600;
      padding: 0.5rem 0 0.4rem; */
    }
    .secondary__img-link {
      height: 220px;
    }
    .secondary-post span {
      font-size: 0.95rem;
    }
    .secondary-post-date {
      font-size: 0.85rem !important;
    }
  }
</style>