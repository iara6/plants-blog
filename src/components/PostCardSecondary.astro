---
// utils imports
import { formatDate } from "../js/utils";

const { frontmatter, url } = Astro.props;

const { title, description, date, category, author, image } = frontmatter;
---



<div class="secondary-post">
  <a class="secondary__img-link" href={url}>
    <img class="secondary-post-image" src={image.src} alt={image.alt}>
  </a>
  <div>
    <h3>
      <a href={url}>{title}</a>
    </h3>
<!--     <span>
      <a href={`/author/${author.slug}/`}>{author.name}</a> • <a href={`/category/${category.slug}/`}>{category.name}</a> • {formatDate(date)} 
    </span>
    <p class="secondary__description">{description}</p> -->
  </div>
</div>


<style>
  .secondary-post a {
    text-decoration: none;
  }
  .secondary-post h3 {
    font-size: 1.3rem;
    font-weight: 600;
    padding: 0.5rem 0;
  }
  .secondary__img-link {
    display: block;
    width: 100%;
    height: 230px;
  }
  .secondary__img-link img {
    width: 100%;
    height: 100%;
    border-radius: 6px;
    object-fit: cover;
  }
  .secondary__description {
    font-size: 1.1rem;
    font-weight: 300;
  }
</style>