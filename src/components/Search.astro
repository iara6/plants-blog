<div class="header__search">
  <form id="search-form" autocomplete="off">
    <input id="search-input" name="q" placeholder="Поиск по сайту" value="" type="search">
    <button aria-label="Search" type="submit">
      <img src="/icons/magnifying-glass.svg" alt="">
    </button>
  </form>

  <div id="search-results"></div>
</div>

<style>
  .header__search {
    width: 300px;
    position: relative;
  }
  .header__search form {
    display: flex;
  }
  .header__search input {
    padding: 0.5rem 0.7rem;
    border-bottom-left-radius: 10px;
    border-top-left-radius: 10px;
    border: 1px solid black;
    width: 100%;
    background-color: var(--secondary-clr);
    color: var(--text-clr-dark);
  }
  .header__search input:focus {
    outline: 1px solid var(--accent-clr-2);
  }
  .header__search button {
    padding: 0 0.5rem;
    background-color: var(--accent-clr-3);
    margin-left: -1px;
    border-bottom-right-radius: 10px;
    border-top-right-radius: 10px;
    border: 1px solid black;
    cursor: pointer;
  }

  #search-results {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;

    width: 100%;
    max-height: 300px;
    overflow-y: auto;

    background-color: var(--secondary-cl-2);
    /* border: 1px solid #ddd; */
    border-radius: 6px;
    box-shadow: 0px 3px 3px 3px rgb(0, 0, 0, 0.25);

    display: none;

    z-index: 100;
  }

  :global(.search-result) {
    display: block;
    padding: 10px;
    cursor: pointer;
    text-decoration: none;
    color: var(--text-clr-dark);
  }
  :global(.search-result):hover {
    background-color: var(--accent-clr-3);
  }
  :global(.search-show-all) {
    display: block;
    text-align: center;
    padding: 8px;
    cursor: pointer;
    text-decoration: none;
    color: var(--text-clr-dark-m);
    opacity: 0.9;
  }
  :global(.search-show-all):hover {
    color: var(--text-clr-dark);
    opacity: 1;
  }
</style>

<script is:inline>
  let pagefind = null;

  async function initPagefind() {
    pagefind = await import("/pagefind/pagefind.js");
  }

  function debounce(fn, delay = 200) {
    let t;
    return (...args) => {
      clearTimeout(t);
      t = setTimeout(() => fn(...args), delay);
    };
  }

  async function renderResults(results) {
    const container = document.getElementById("search-results");
    const items = results?.results ?? [];

    if (!items.length) {
      container.style.display = "none";
      container.innerHTML = "";
      return;
    }

    const resolved = await Promise.all(
      items.slice(0, 5).map(async (r) => {
        const data = await r.data();
        console.log("RESULT DATA:", data);
        const title =
          data?.meta?.title ||
          data?.title ||
          "Untitled";

        return {
          url: data.url || data.raw_url,
          title
        };
      })
    );

    container.innerHTML = resolved
      .map(
        (r) => `
          <a class="search-result" href="${r.url}">
            ${r.title}
          </a>
        `
      )
      .join("");

    const query = document.getElementById("search-input").value;

    if (items.length > 5) {
      container.innerHTML += `
        <a class="search-show-all" href="/search/?q=${encodeURIComponent(query)}">
          Показать все ${items.length} результатов
        </a>
      `;
    }

    container.style.display = "block";
  }

  document.addEventListener("DOMContentLoaded", async () => {
    await initPagefind();

    const input = document.getElementById("search-input");
    const form = document.getElementById("search-form");
    const container = document.getElementById("search-results");


    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const query = input.value;
      window.location.href = `/search/?q=${encodeURIComponent(query)}`;
    });

    const runSearch = debounce(async (query) => {
      if (!query || query.trim().length < 2) {
        container.style.display = "none";
        return;
      }

      try {
        const results = await pagefind.search(query);

       /*  console.log("PAGEFIND RAW RESULTS:", results);
        console.log("FIRST ITEM:", results?.results?.[0]); */

        renderResults(results);
      } catch (err) {
        console.error("Pagefind search failed:", err);
      }
    }, 200);

    input.addEventListener("input", (e) => {
      runSearch(e.target.value);
    });

    document.addEventListener("click", (e) => {
      if (!e.target.closest(".header__search")) {
        container.style.display = "none";
      }
    });
  });
</script>

