---
// utils imports
import { formatDate } from "../js/utils";

const { frontmatter, url /* tagType */ } = Astro.props;
/* const Tag = tagType; */

const { title, description, date, category, author, image } = frontmatter;
---

<div class="trending-post-container">
  <a class="trending-post_img-wrapper" href={url}>
    <img class="trending-post-image" src={image.src} alt={image.alt}>
  </a>
  <div> 
    <h3><a href={url}>{title}</a></h3>
    <span class="trending-post-date">{formatDate(date)}</span> • <span class="article-category"><a href={`/category/${category.slug}/`}>{category.name}</a></span>
  </div>
</div>

<style>
   .trending-post-container {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
    /* border: 2px solid hotpink; */
  }
  .trending-post_img-wrapper {
    width: 110px;
    height: 110px;
    aspect-ratio: 1 / 1;
  }
  .trending-post_img-wrapper img {
    /* add to each width="110" height="110" */
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  .trending-post-container h3 {
    font-size: 1.1rem;
    font-weight: 500;
  }

  .trending-post-container span {
    font-size: 0.9rem;
    opacity: 0.9;
  }


  
</style>