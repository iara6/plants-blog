---
// utils imports
import { formatDate } from "../js/utils";

const { frontmatter, url } = Astro.props;

const { title, description, date, category, author, image } = frontmatter;
---

<div class="trending-post-container">
  <a class="trending-post_img-wrapper" href={url}>
    <img class="trending-post-image" src={image.src} alt={image.alt}>
  </a>
  <div>
    <span class="article-category media-query"><a href={`/category/${category.slug}/`}>{category.name}</a></span> 
    <h3><a href={url}>{title}</a></h3>
    <!-- <span class="trending-post-date">{formatDate(date)}</span> • --><span class="article-category trending"><a href={`/category/${category.slug}/`}>{category.name}</a></span>
  </div>
</div>

<style>
  .trending-post-container {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 0;
  }
  .article-category.media-query {
    display: none;
  }
  .trending-post-container a {
    color: var(--text-clr-dark);
    text-decoration: none;
  }
  .trending-post_img-wrapper {
    width: 110px;
    height: 110px;
    aspect-ratio: 1 / 1;
  }
  .trending-post_img-wrapper img {
    /* add to each width="110" height="110" */
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }
  .trending-post-container h3 {
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .trending-post-container span {
    font-size: 0.85rem;
    /* opacity: 0.8; */
  }

  @media screen and (max-width:1300px) {
    .trending-post_img-wrapper {
      width: 100px;
      height: 100px;
    }
    .trending-post-container h3 {
    font-size: 1rem;
    }
  }

  @media screen and (max-width:1200px) {
    .trending-post-container {
      flex-direction: column;
      gap: 0.8rem;
      /* max-width: 160px; */
      text-align: center;
      padding-inline: 1rem;
    }
    .trending-post_img-wrapper {
      width: 175px;
      height: 175px;
    }
    .trending-post-image {
      border: 1px solid var(--accent-clr-2);
    }
    .article-category.media-query {
      display: block;
      width: fit-content;
      margin-inline: auto;
      margin-bottom: 0.5rem;
    }
    .article-category.trending {
      display: none;
    }
    .trending-post-container h3 {
      font-size: 1.15rem;
      font-weight: 500;
      margin-bottom: 0;
    }
  }

  @media screen and (max-width: 640px) {
    .trending-post_img-wrapper {
      width: 160px;
      height: 160px;
    }
    .trending-post-container h3 {
      font-size: 1.07rem;
    }
  }
</style>