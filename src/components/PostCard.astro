---
// utils imports
import { formatDate } from "../js/utils";

const { frontmatter, url } = Astro.props;

const { title, description, date, category, author, image } = frontmatter;
---

<div class="author-post">
  <a href={url}>
    <img class="author-post-image" src={image.src} alt={image.alt}>
  </a>
  <h3>
    <a href={url}>{title}</a>
  </h3>
  <span>
    <span class="post-date">{formatDate(date)}</span> • <a href={`/author/${author.slug}/`}>{author.name}</a>  
    <!-- <a href={`/category/${category.slug}/`}>{category.name}</a> •  -->
  </span>
  <p class="author-post-description">{description}</p>
</div>

<style>
  .author-post-image {
    height: 300px;
    width: 100%;
    object-fit: cover;
    border-radius: 6px;
  }
  .author-post a {
    color: var(--primary-clr-dark);
    text-decoration: none;
  }
  .author-post h3 {
    font-size: 1.35rem;
    font-weight: 600;
    padding: 0.5rem 0 0.4rem;
  }
  .author-post span {
    opacity: 0.9;
  }
  .post-date {
    font-size: 0.9rem;
  }
  .author-post-description {
    margin-top: 0.5rem;
    font-size: 1.05rem;
  }

  @media screen and (max-width: 768px) {
    .author-post h3 {
      font-size: 1.2rem;
    }
    .author-post span {
      font-size: 0.95rem;
    }
    .post-date {
      font-size: 0.85rem !important;
    }
    .author-post-description {
      font-size: 1rem;
    }
  }

  @media screen and (max-width: 688px) { 
    .author-post {
      border-bottom: 1px solid rgb(153, 152, 152, 0.5);
      padding-bottom: 1rem;
    }
  }

 /*  @media screen and (max-width: 550px) { 
    .author-post-image {
      height: 300px;
      width:300px;
      display: block;
      margin-inline: auto;
    }
  } */

  @media screen and (max-width: 320px) {
    .author-post-image {
      height: 250px;
    }
  }

  @media screen and (max-width: 270px) {
    .author-post-image {
      height: 210px;
    }
  }
  
</style>