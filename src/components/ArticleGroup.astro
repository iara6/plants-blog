---
// component imports
import PostCard from "./PostCard.astro";
import PostCardFeatured from "./PostCardFeatured.astro";

// utils imports
import { slugify } from "../js/utils";

const {
  featured,
  secondary,
  featuredOnLeft = true,
} = Astro.props;
---

