---
// component imports
import PostCard from "./PostCard.astro";
import PostCardFeaturedOther from "./PostCardFeaturedOther.astro";

// utils imports
import { slugify } from "../js/utils";

const {
  featured,
  secondary,
  featuredOnLeft = true,
} = Astro.props;
---

<section class={`menu-section-articles-container   
    ${!featured ? "no-featured" : ""}
    ${!featuredOnLeft ? "reverse" : ""}`}>
  {
    featuredOnLeft ? (
      <>
      {featured && (
        <div class="menu-section__highlight">
          <PostCardFeaturedOther
            frontmatter={featured.frontmatter}
            url={`/${featured.frontmatter.category.slug}/${slugify(featured.frontmatter.title)}`}
          />
          <span><img class="plant-design" src="/images/elements/plant-design1.png"></span>
        </div>
      )}
        <div class="menu-section__secondary">
          {
            secondary.map(post => (
              <PostCard
                frontmatter={post.frontmatter}
                url={`/${post.frontmatter.category.slug}/${slugify(post.frontmatter.title)}`}
              />
            ))
          }
        </div>
      </>
    ) : (
      <>
        <div class="menu-section__secondary">
          {
            secondary.map(post => (
              <PostCard
                frontmatter={post.frontmatter}
                url={`/${post.frontmatter.category.slug}/${slugify(post.frontmatter.title)}`}
              />
            ))
          }
        </div>

        {featured && (
          <div class="menu-section__highlight">
            <PostCardFeaturedOther
              frontmatter={featured.frontmatter}
              url={`/${featured.frontmatter.category.slug}/${slugify(featured.frontmatter.title)}`}
            />
          </div>
        )}
      </>
    )
  }
</section>

<style>
  .menu-section-articles-container {
    display: grid;
    grid-template-columns: 1.5fr 2fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .menu-section__secondary {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .menu-section-articles-container.reverse {
    grid-template-columns: 2fr 1.5fr;
  }
  .plant-design {
    width: 100%;
    max-width: 500px;
  }

  @media screen and (max-width:1050px) {
    .menu-section-articles-container {
      grid-template-columns: 1fr;
      margin-bottom: 1.5rem;
    }
    .menu-section-articles-container.reverse {
      grid-template-columns: 1fr;
    }
    .menu-section__highlight {
      max-width: 70%;
    }
    .menu-section__highlight:nth-child(even) {
      justify-self: end;
    }
  }
  @media screen and (max-width: 686px) {
    .menu-section__highlight {
      border-bottom: 1px solid rgb(153, 152, 152, 0.5);
      padding-bottom: 1rem;
      max-width: none;
    }
    .menu-section__secondary {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr;
    }
  }
</style>