---
// utils imports
import { formatDate } from "../js/utils";

const { title, date, category, author, image } = Astro.props;
---

<div class="post-header-container">
  <h1>{title}</h1>
  <div class="post-header-data">
    <a href={`/author/${author.slug}/`}>{author.name}</a> • <a class="article-category" href={`/category/${category.slug}/`}>{category.name}</a> • <span class="post-header-date">{formatDate(date)}</span>
  </div>  
</div>

<style>
  .post-header-container {
    text-align: center;
    margin-bottom: 1rem;
    color: var(--text-clr-dark);
  }
  .post-header-container h1 {
    font-size: 2.2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .post-header-container a {
    color: var(--text-clr-dark);
    text-decoration: none;
  }
  .post-header-container .article-category {
    color: var(--text-clr-dark-perm);
  }
  .post-header-date {
    font-size: 0.95rem;
  }

  @media screen and (max-width: 768px) {
    .post-header-container h1 {
      font-size: 2rem;
    }
  }
  @media screen and (max-width: 640px) { 
    .post-header-container h1 {
      font-size: 1.6rem; 
    }
  }

</style>