---
// utils imports
import { formatDate } from "../js/utils";

const { title, date, category, author, image } = Astro.props;
---

<div class="post-header-container">
  <h1>{title}</h1>
  <div class="post-header-data">
    <a href={`/author/${author.slug}/`}>{author.name}</a> • <a class="article-category" href={`/category/${category.slug}/`}>{category.name}</a> • {formatDate(date)}
  </div>  
</div>

<style>
  .post-header-container {
    text-align: center;
    margin-bottom: 1rem;
    color: var(--primary-clr-dark);
    /*   border: 1px solid red; */
  }
  .post-header-container h1 {
    font-size: 2.2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .post-header-container a {
    color: var(--primary-clr-dark);
    text-decoration: none;
  }

   @media screen and (max-width: 768px) {
    .post-header-container h1 {
      font-size: 2rem;
     /*  font-weight: 600;
      margin-bottom: 0.5rem; */
    }
  }
    @media screen and (max-width: 640px) { 
      .post-header-container h1 {
      font-size: 1.6rem; 
    }

  }
</style>