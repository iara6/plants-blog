---
// utils imports
import { slugify, formatDate } from "../js/utils";

const { relatedPosts } = Astro.props;
---

{
  relatedPosts.map((post) => (
    <div class="related-post">
      <div class="related-post__img-container">
        <a href={`/${post.frontmatter.category.slug}/${slugify(post.frontmatter.title)}`}>
          <img class="related-post-image" src={post.frontmatter.image.src} alt={post.frontmatter.image.alt}>
        </a>
      </div>
      <div class="related-post__info-container">
        <h3>
          <a href={`/${post.frontmatter.category.slug}/${slugify(post.frontmatter.title)}`}>{post.frontmatter.title}</a>
        </h3>
        <span class="related-data">
          <span class="related-post-date">{formatDate(post.frontmatter.date)}</span> • <a href={`/author/${post.frontmatter.author.slug}/`}>{post.frontmatter.author.name}</a> {/* <a class="article-category" href={`/category/${slugify(post.frontmatter.category.slug)}/`}>{post.frontmatter.category.name}</a>*/}
        </span>
      </div>
    </div>   
  ))
}

<style>
  .related-post {
    border-bottom: 1px solid rgb(153, 152, 152, 0.5);
    padding-bottom: 1rem;
  }
  .related-post:not(:first-child)  {
    padding-top: 1.2rem;
  }
  .related-post-image {
    height: 280px;
    width: 100%;
    object-fit: cover;
    border-radius: 6px;
  }
  .related-post a {
    color: var(--text-clr-dark);
    text-decoration: none;
  }
  .related-post h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0.8rem 0 0.4rem;
  }
  .related-post-date {
    font-size: 0.9rem;
    color: var(--text-clr-dark-m);
  }
  .related-data a {
    color: var(--text-clr-dark-m);
  }

  @media screen and (max-width:1400px) {
    .related-post-image {
      height: 270px;
    }
  }
  @media screen and (max-width:1200px) {
    .related-post {
      border: none;
      padding: 0 !important;
    }
  }
  @media screen and (max-width: 768px) {
    .related-post {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.5rem 0 !important;
    }
    .related-post:not(:last-child) {
      border-bottom: 1px solid rgb(153, 152, 152, 0.5);
    }
    .related-post__img-container {
      width: 160px;
      height: 160px;
      flex-shrink: 0;
    }
    .related-post-image {
      height: 100%;
      width: 100%;
    }
  }
  @media screen and (max-width: 640px) {
    .related-post__img-container {
      width: 130px;
      height: 130px;
    }
  }
  @media screen and (max-width: 480px) {
    .related-post__img-container {
      width: 115px;
      height: 115px;
    }
     .related-post h3 {
      font-size: 1.2rem;
    }
    .related-post span {
      font-size: 0.9rem;
    }
    .related-post-date {
      font-size: 0.85rem;
    }
  }
  
</style>